import json
import sys
import agent
import os
import secrets

# Try to parse the stdin as JSON.
# If parsing fails, output everything to stderr
data = json.load(sys.stdin)

# CouchDB 3 refuses to start without an administrator ("Admin Party"):
# keep the current one, or create admin with a generated password
try:
    _current = agent.read_envfile("couchdb.env")
except FileNotFoundError:
    _current = {}
COUCHDB_USERNAME = data.get("couchdb_username") or _current.get("COUCHDB_USER") or "admin"
COUCHDB_PASS = data.get("couchdb_password") or _current.get("COUCHDB_PASSWORD") or secrets.token_urlsafe(16)
HOST = data.get("host", "")
app_config = {
    "COUCHDB_USER": COUCHDB_USERNAME,
    "COUCHDB_PASSWORD": COUCHDB_PASS,
    "HOST": HOST,
    "COUCHDB_BIND_ADDRESS": "0.0.0.0",
    "COUCHDB_CREATE_DATABASES": "yes",
    "COUCHDB_SINGLE_NODE": "true",
}
agent.write_envfile("couchdb.env", app_config)
os.chmod("couchdb.env", 0o600)  # holds the administrator password

